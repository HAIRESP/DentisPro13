# Conta e sessões locais no servidor. Use disco persistente e backup desta pasta.
DENTISPRO_DATA_DIR=".dentispro-data"
DENTISPRO_HOST="127.0.0.1"
# Para vários computadores, configure um proxy HTTPS e a origem exata.
# DENTISPRO_PUBLIC_ORIGIN="https://dentispro.seudominio.com"
# IA opcional. Fica desativada até ser escolhida nas configurações.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL="deepseek-chat"
# PostgreSQL opcional; não configura sincronização clínica automaticamente.
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
