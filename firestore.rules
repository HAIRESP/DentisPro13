rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Own authentication profile only. Account management is audited on the server.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    // All clinical data, permissions, versions and audit indexes go through the server.
    // No broad admin wildcard: that would override the deny below.
    match /{document=**} { allow read, write: if false; }
  }
}
